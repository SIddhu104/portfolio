# ═══════════════════════════════════════════════════════
#  Portfolio Environment Variables Template
# ═══════════════════════════════════════════════════════

# Database
MONGODB_URI=your-mongodb-connection-string


# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Initial Admin Setup
ADMIN_SETUP_SECRET=replace-with-a-one-time-setup-secret

# Email Delivery (Gmail SMTP with App Password)
# 1. Open Google Account -> Security -> 2-Step Verification
# 2. Go to "App passwords" -> Create one for "Portfolio"
# 3. Enter your Gmail and 16-character app password below (spaces are removed automatically):
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Email address to receive notifications
CONTACT_RECEIVER_EMAIL=siddheshkorade10@gmail.com

# (Optional fallback) Resend Email API Key
RESEND_API_KEY=

# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
